# Environment
NODE_ENV=development
PORT=8000
BASE_URL=http://localhost:8000
ALLOW_OPENAPI=true

# Neon Postgres
# Get connection string from https://console.neon.tech
DATABASE_URL=

# Authentication
BETTER_AUTH_SECRET=

# Polar Integration
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=
POLAR_PRO_PRODUCT_ID=
POLAR_PRO_SLUG=

# CORS
CORS_ORIGIN=

# Rate limiter
RATE_LIMIT_MODE=memory
# REDIS_URL=redis://redis:6379

# Google Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend API
RESEND_API_KEY=

# Slack
SLACK_NOTIFICATION_URL=

# Logging
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=

# x402 Payment Gateway
# Required — the platform wallet that receives every payment (20-byte EVM
# address). The gateway cannot issue a 402 challenge without it.
PAY_TO=
# CAIP-2 chain id the gateway settles on. eip155:84532 = Base Sepolia (default),
# eip155:8453 = Base mainnet.
X402_NETWORK=eip155:84532
# Facilitator that verifies and settles payments. The public x402.org
# facilitator is testnet-only: the server refuses to start if it is paired with
# any chain other than eip155:84532.
FACILITATOR_URL=https://x402.org/facilitator
# Zapx's cut of each payment, as a percentage (0-100).
PLATFORM_FEE_PERCENT=10