{
  "name": "@turborepo-boilerplate/services",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "email-preview": "email dev --port 3002 --dir src/email/templates"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/tailwind": "^2.0.7",
    "@turborepo-boilerplate/env": "workspace:*",
    "dotenv": "catalog:",
    "ioredis": "^5.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "react-email": "6.9.1",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  }
}
